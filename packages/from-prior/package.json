{
  "name": "@estoc/from-prior",
  "version": "0.1.0",
  "description": "DIDComm v2 from_prior proofs under a did:peer:4 + Ed25519 profile: inspect, precheck, verify and create a proof, and bind a verified one to the receipt it arrived on.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-dev/estoc.git",
    "directory": "packages/from-prior"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@estoc/did-peer": "workspace:^",
    "@scure/base": "^1.2.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "estoc",
    "didcomm",
    "from_prior",
    "did-rotation",
    "did-peer"
  ]
}
