{
  "name": "@estoc/continuity",
  "version": "0.1.0",
  "description": "Continuity between oriented DID pairs: a pure model that derives heads, paths, confirmation and conflicts from facts identified by their content (peer observations, peer endings, local decisions), without choosing winners.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-dev/estoc.git",
    "directory": "packages/continuity"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "canonicalize": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "estoc",
    "did-rotation",
    "continuity"
  ]
}
