{
  "name": "@estoc/did-web",
  "version": "0.1.0",
  "description": "did:web under a network policy: the one URL a DID names, its inverse from a service URL, and a fetch that follows no redirect, reads a bounded body within a deadline and keeps only a document that calls itself by the DID. Tells a final answer from no answer now. The transport is the host's; @estoc/did-web/node is one for Node that refuses every address that is not public unicast.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-dev/estoc.git",
    "directory": "packages/did-web"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "did",
    "did-web",
    "decentralized-identity",
    "ssrf"
  ]
}
