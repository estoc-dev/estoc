{
  "name": "@estoc/daemon-api",
  "version": "0.1.0",
  "description": "The public contract between an Estoc daemon and its views: API-owned records, method inputs and results, events, stable error codes, runtime schemas, the API version, and the pure helpers a view computes with. A view installs this package alone; the daemon adapts its domain results into these shapes.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-dev/estoc.git",
    "directory": "packages/daemon-api"
  },
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "default": "./dist/wire/index.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "default": "./dist/views/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "consumer-check": "node scripts/consumer-check.mjs",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "vitest": "^3.2.7",
    "ws": "^8.18.0"
  },
  "keywords": [
    "estoc",
    "didcomm",
    "daemon",
    "api",
    "contract"
  ]
}
