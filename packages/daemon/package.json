{
  "name": "@estoc/daemon",
  "version": "0.4.0",
  "description": "The Estoc daemon: an agent and its vault behind the API of @estoc/daemon-api, which any view attaches to. The same core runs in a browser worker (OPFS) and as a Node process (`estoc-daemon`, a SQLite vault in a folder on disk, a WebSocket the app connects to).",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-dev/estoc.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "bin": {
    "estoc-daemon": "./dist/node/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@estoc/agent-core": "workspace:^",
    "@estoc/daemon-api": "workspace:^",
    "@estoc/didcomm-node": "^0.4.1-estoc.4",
    "@estoc/event-store": "workspace:^",
    "@estoc/keystore": "workspace:^",
    "@estoc/vault": "workspace:^",
    "@scure/base": "^1.2.0",
    "ipaddr.js": "^2.2.0",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@estoc/didcomm": "^0.4.1-estoc.4",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.62.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "didcomm",
    "did",
    "agent",
    "daemon",
    "decentralized-identity"
  ],
  "peerDependencies": {
    "@estoc/app": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@estoc/app": {
      "optional": true
    }
  }
}
