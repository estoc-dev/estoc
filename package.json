{
  "name": "estoc-pwa",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint packages/agent-core/src",
    "dev": "pnpm -r --parallel run dev",
    "e2e": "pnpm --filter @estoc/app run e2e",
    "release-check": "node scripts/release-check.mjs",
    "bench": "node scripts/bench-growth.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "semver": "^7.8.5",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.122.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@estoc/app"
      ]
    }
  }
}
