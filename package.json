{
  "name": "estoc-pwa",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "e2e": "pnpm --filter @estoc/app run e2e",
    "release-check": "node scripts/release-check.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "semver": "^7.8.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.122.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@estoc/app"
      ]
    }
  }
}
